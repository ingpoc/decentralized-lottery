#!/bin/bash

# Post-Bash Hook - Automatic IDL Sync After Successful Builds
# Triggers: After successful anchor/cargo build commands

set -e

# Cache configuration
CACHE_DIR=".claude/cache"
CACHE_EXPIRY=60  # 1 minute

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

log_info() {
    echo -e "${BLUE}ℹ️  [POST-BUILD]${NC} $1"
}

log_success() {
    echo -e "${GREEN}✅ [POST-BUILD]${NC} $1"
}

log_warning() {
    echo -e "${YELLOW}⚠️  [POST-BUILD]${NC} $1"
}

log_error() {
    echo -e "${RED}🔴 [POST-BUILD]${NC} $1"
}

# Main function
main() {
    local command="${CLAUDE_BASH_COMMAND:-}"
    
    # Only run for build commands
    if [[ "$command" != *"anchor build"* && "$command" != *"npm run build"* && "$command" != *"cargo build"* ]]; then
        return 0
    fi
    
    # Check if command succeeded (exit code 0)
    local exit_code="${CLAUDE_BASH_EXIT_CODE:-0}"
    if [[ $exit_code -ne 0 ]]; then
        log_info "Build failed, skipping IDL sync"
        return 0
    fi
    
    log_info "Post-build IDL synchronization triggered"
    
    # Auto-sync IDL files if they were generated
    if [[ -d "target/idl" ]]; then
        local idl_count=$(find target/idl -name "*.json" 2>/dev/null | wc -l | tr -d ' ')
        
        if [[ $idl_count -gt 0 ]]; then
            log_info "Found $idl_count IDL files, syncing to frontend..."
            
            # Run sync command
            if npm run sync-idl >/dev/null 2>&1; then
                log_success "IDL files automatically synced to frontend"
            else
                log_warning "IDL sync failed, may need manual intervention"
            fi
        fi
    fi
    
    return 0
}

# Run main function
main "$@"