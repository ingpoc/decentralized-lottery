# Anchor
.anchor
target
**/*.rs.bk

# Node
node_modules
package-lock.json

# Solana
test-ledger
.env
*.pem

# Build artifacts
# NOTE: Cargo.lock is intentionally committed — Solana SBF builds require a
# pinned dependency tree (transitive crates like blake3/block-buffer must not
# float to editions the platform-tools cargo can't parse).
*.log
*.tsbuildinfo
*.cache

# Editor
.idea
.vscode
*.swp
*.swo

# Temporary files
*.tmp
*.bak
*.old
*.orig
*.rej

# Accidentally created frontend build artifacts
.next/
out/
.DS_Store

# Frontend
frontend/node_modules
frontend/.next
frontend/.env.local
